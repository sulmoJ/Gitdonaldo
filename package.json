{
  "name": "gitdonaldo",
  "productName": "Gitdonaldo",
  "version": "0.1.0",
  "description": "Minimal git client desktop app for macOS (Electron + system git)",
  "author": "Gitdonaldo contributors",
  "main": "electron/main.js",
  "desktopName": "gitdonaldo.desktop",
  "bin": {
    "gitdonaldo": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "test": "node --test",
    "test:e2e": "node e2e/electron.e2e.js",
    "dist": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "playwright-core": "1.63.0"
  },
  "build": {
    "appId": "io.gitdonaldo.app",
    "productName": "Gitdonaldo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "syncDesktopName": true,
      "executableName": "gitdonaldo",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": null
  }
}
